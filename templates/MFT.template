name: DetectRaptor.Windows.Detection.MFT
author: Matt Green - @mgreen27
description: |
   Bulk indicator hunt over Windows.NTFS.MFT.

   This artifact is automatically generated by DetectRaptor.

reference:
  - https://github.com/mgreen27/DetectRaptor

type: CLIENT
resources:
  timeout: 9000

parameters:
   - name: DateAfter
     type: timestamp
     description: "search for events after this date. YYYY-MM-DDTmm:hh:ssZ"
   - name: DateBefore
     type: timestamp
     description: "search for events before this date. YYYY-MM-DDTmm:hh:ssZ"
   - name: AllDrives
     type: bool
     description: "Select MFT search on all attached ntfs drives."
   - name: CriticalityLevel
     default: .
     description: "Only use detections matching this regex (values can be Critical,High,Medium,Low)"
   - name: ApprovedRMMNameRegex
     default: ^$
     description: "Optional regex matching approved RMM detection names. Must be combined with ApprovedRMMPathRegex."
   - name: ApprovedRMMPathRegex
     default: ^$
     description: "Optional regex matching approved RMM installation paths. Must be combined with ApprovedRMMNameRegex."
   - name: SuppressWhitelisted
     type: bool
     default: true
     description: "Suppress built-in RuleID, filename, and path whitelist matches. Disable to audit suppressed rows."
   - name: Whitelists
     type: csv
     default: |
%whitelist%
   - name: IOCs
     type: csv
     default: |
%splitme% 

sources:
  - precondition:
      SELECT OS From info() where OS = 'windows'

    query: |
      -- firstly split IOCs by path or filename focus
      LET all_the_things <= SELECT * FROM IOCs
        WHERE NOT KeywordRegex = '.'
            AND Criticality =~ CriticalityLevel
            AND Scope =~ '^(MFT|Both)$'

      LET whitelist_lookup <= memoize(
        key='LookupKey',
        query={
          SELECT *, RuleID + '|MFT' AS LookupKey
          FROM Whitelists
          WHERE Artifact = 'MFT'
              AND Disposition = 'Suppress'
        }, period=100000)

      LET keyword_patterns <= SELECT KeywordRegex
        FROM all_the_things
        GROUP BY KeywordRegex

      LET hits = SELECT EntryNumber,InUse,OSPath,FileName,FileSize,IsDir,
            Created0x10,LastModified0x10,LastRecordChange0x10,LastAccess0x10,
            Created0x30,LastModified0x30,LastRecordChange0x30,LastAccess0x30
        FROM Artifact.Windows.NTFS.MFT(
                                FileRegex=join(array=keyword_patterns.KeywordRegex,sep='|'),
                                DateBefore=DateBefore,
                                DateAfter=DateAfter,
                                AllDrives=AllDrives )

      -- output results and enrich with IOC data
      LET rule_hits = SELECT * FROM foreach(row=hits,query={
            SELECT
                RuleID,
                Detection as DetectionName,
                Category,
                Technique,
                Confidence,
                Criticality,
                Source,
                SourceID,
                FileName,
                dict(
                    RuleID=RuleID,
                    Name=Detection,
                    Category=Category,
                    Technique=Technique,
                    Confidence=Confidence,
                    KeywordRegex=KeywordRegex,
                    PathRegex=PathRegex,
                    IgnoreRegex=IgnoreRegex,
                    Reference=Reference,
                    Scope=Scope,
                    EntryType=EntryType,
                    Source=Source,
                    SourceID=SourceID,
                    StringHit=parse_string_with_regex(string=FileName,regex='(' + KeywordRegex + ')' ).g1,
                    Criticality=Criticality
                        ) as Detection,
                if(condition=OSPath =~ '''\\<Err\>|\\<UnknownEntry\>|\\<Parent ''',
                    then='Unresolved',
                    else=if(condition=OSPath =~ '''\\Users\\|\\Windows\\(Temp|SystemTemp)\\|\\\$Recycle\.Bin\\''',
                        then='User or temporary',
                        else=if(condition=OSPath =~ '''\\Program Files( \(x86\))?\\|\\ProgramData\\chocolatey\\''',
                            then='Installed',
                            else=if(condition=OSPath =~ '''\\ProgramData\\''',
                                then='ProgramData',
                                else=if(condition=OSPath =~ '''\\Windows\\''',
                                    then='System',
                                    else='Other'))))) as LocationContext,
                if(condition=Category = 'Remote Access Software',
                    then=if(condition=Detection =~ ApprovedRMMNameRegex
                            AND OSPath =~ ApprovedRMMPathRegex,
                        then='Approved',
                        else='Review'),
                    else='Not applicable') as RMMDisposition,
                EntryNumber,InUse,OSPath,FileSize,IsDir,
                dict(Created0x10=Created0x10,LastModified0x10=LastModified0x10,LastRecordChange0x10=LastRecordChange0x10,LastAccess0x10=LastAccess0x10) as SITimestamps,
                dict(Created0x30=Created0x30,LastModified0x30=LastModified0x30,LastRecordChange0x30=LastRecordChange0x30,LastAccess0x30=LastAccess0x30) as FNTimestamps
            FROM all_the_things
            WHERE FileName =~ KeywordRegex
                AND OSPath =~ PathRegex
                AND (EntryType = 'Any'
                    OR (EntryType = 'File' AND NOT IsDir)
                    OR (EntryType = 'Directory' AND IsDir))
                AND NOT if(condition=IgnoreRegex,
                        then= OSPath =~ IgnoreRegex,
                        else= False )
        },workers=20)

      LET candidate_hits = SELECT *,
          get(
            item=whitelist_lookup,
            field=RuleID + '|MFT') AS WhitelistCandidate
        FROM rule_hits

      LET classified_hits = SELECT *,
          if(
            condition=WhitelistCandidate
              AND FileName =~ WhitelistCandidate.FilenameRegex
              AND OSPath =~ WhitelistCandidate.PathRegex,
            then='Suppressed',
            else='Retained') AS Disposition
        FROM candidate_hits

      SELECT * FROM classified_hits
      WHERE NOT SuppressWhitelisted
          OR Disposition != 'Suppressed'

    notebook:
      - type: vql_suggestion
        name: Detection summary
        template: |
            /*
            ### Detection summary
            */

            SELECT Detection.RuleID,
               Detection.Name,
               Detection.Category as Category,
               Detection.Criticality as Criticality,
               count() AS Total
            FROM source()
            GROUP BY Detection.RuleID
            ORDER BY Total DESC
      - type: vql_suggestion
        name: Operational metrics
        template: |
            /*
            ### Operational metrics
            Separate total rule matches from unique endpoint paths and
            multi-match expansion.
            */

            LET DRRows = SELECT * FROM source()
            LET DRPaths = SELECT Fqdn,OSPath,count() AS MatchCount
                FROM DRRows
                GROUP BY Fqdn,OSPath
            LET DRMultiPaths = SELECT * FROM DRPaths
                WHERE MatchCount > 1
            LET DREndpoints = SELECT Fqdn FROM DRRows
                GROUP BY Fqdn

            SELECT * FROM chain(
                rule_matches={
                    SELECT 'Rule matches' AS Metric,count() AS Value
                    FROM DRRows
                },
                unique_paths={
                    SELECT 'Unique endpoint paths' AS Metric,count() AS Value
                    FROM DRPaths
                },
                multi_match_paths={
                    SELECT 'Multi-match endpoint paths' AS Metric,
                        count() AS Value
                    FROM DRMultiPaths
                },
                endpoints={
                    SELECT 'Endpoints' AS Metric,count() AS Value
                    FROM DREndpoints
                })
      - type: vql_suggestion
        name: Rule path prevalence
        template: |
            /*
            ### Rule path prevalence
            Count each RuleID and endpoint path once.
            */

            LET DRRulePaths = SELECT RuleID,DetectionName,Category,
                    Confidence,Criticality,Fqdn,OSPath
                FROM source()
                GROUP BY RuleID,Fqdn,OSPath

            SELECT RuleID,DetectionName,Category,Confidence,Criticality,
                count() AS UniqueEndpointPaths,
                enumerate(items=Fqdn) AS Endpoints,
                OSPath AS ExampleOSPath
            FROM DRRulePaths
            GROUP BY RuleID
            ORDER BY UniqueEndpointPaths DESC
      - type: vql_suggestion
        name: File match summary
        template: |
            /*
            ### File match summary
            Group every matching rule for the same OSPath on each endpoint.
            */

            SELECT Fqdn,
                OSPath,
                count() as MatchCount,
                enumerate(items=Detection.RuleID) as RuleIDs,
                enumerate(items=Detection.Name) as Detections,
                enumerate(items=Detection.Category) as Categories,
                enumerate(items=Detection.Technique) as Techniques,
                enumerate(items=Detection.Confidence) as Confidences,
                enumerate(items=Detection.Criticality) as Criticalities,
                EntryNumber,
                InUse,
                IsDir,
                FileSize,
                SITimestamps,
                FNTimestamps
            FROM source()
            GROUP BY Fqdn,OSPath
            ORDER BY MatchCount DESC
      - type: vql_suggestion
        name: Timeline preparation
        template: |
            /*
            ### Create timestamps for timeline - typically Modified is best timestamp.
            */

            SELECT *, 
               Detection.Name + "|" + Detection.StringHit + "|" + OSPath as Message,
               SITimestamps.LastModified0x10 as SIModified,
               SITimestamps.Created0x10 as SICreated
            FROM source()


      - type: vql_suggestion
        name: Criticality filter
        template: |
            /*
            ### Detection filter
            Use this notebook to modify filter and target specific Criticality Detections.
            */

            SELECT Fqdn,
                Detection.Name as Detection,
                Detection.Criticality as Criticality,
                OSPath,
                Detection.StringHit as StringHit,
                Detection.KeywordRegex as KeywordRegex,
                InUse,IsDir,FileSize,
                SITimestamps.Created0x10 as Created0x10,
                SITimestamps.LastModified0x10 as LastModified0x10,
                FNTimestamps.Created0x30 as Created0x30,
                FNTimestamps.LastModified0x30 as LastModified0x30
            FROM source()
            WHERE Detection.Criticality =~ 'Critical|High'


      - type: vql_suggestion
        name: Detection filter
        template: |
            /*
            ### Detection filter
            Use this notebook to modify filter and target specific Detections.
            */

            SELECT Fqdn,
                Detection.Name as Detection,
                Detection.Criticality as Criticality,
                OSPath,
                Detection.StringHit as StringHit,
                Detection.KeywordRegex as KeywordRegex,
                InUse,IsDir,FileSize,
                SITimestamps.Created0x10 as Created0x10,
                SITimestamps.LastModified0x10 as LastModified0x10,
                FNTimestamps.Created0x30 as Created0x30,
                FNTimestamps.LastModified0x30 as LastModified0x30
            FROM source()
            WHERE Detection.Name =~ 'Defence Evasion|RMM'

      - type: vql_suggestion
        name: Detection folder grouping
        template: |
            /*
            ### Detection folder grouping
            Use this notebook to modify group by folder and figure out ignore list filters
            */

            SELECT Fqdn,
                Detection.Name as Detection,
                Detection.StringHit as StringHit,
                Detection.KeywordRegex as KeywordRegex,
                if(condition= IsDir,
                    then= OSPath, else=dirname(path=OSPath)) as Directory,
                count() as Total,
                OSPath as ExampleOSPath
            FROM source()
            WHERE Detection.Name =~ 'Defence Evasion|RMM'
                --AND NOT OSPath =~ '''ADD HERE'''
            GROUP BY Fqdn,Detection,Directory

      - type: vql_suggestion
        name: RMM location summary
        template: |
            /*
            ### RMM location summary
            Separate installed, portable, unresolved, and other RMM locations.
            */

            SELECT RuleID,
                DetectionName as Detection,
                SourceID,
                RMMDisposition,
                LocationContext,
                count() as Total,
                enumerate(items=Fqdn) as Endpoints,
                OSPath as ExampleOSPath
            FROM source()
            WHERE DetectionName =~ '^(RMM|Remote Access)'
            GROUP BY RuleID,RMMDisposition,LocationContext
            ORDER BY Total DESC

      - type: vql_suggestion
        name: RMM portable or unusual paths
        template: |
            /*
            ### RMM portable or unusual paths
            Review unapproved RMM in user, temporary, unresolved, or other paths.
            */

            SELECT *
            FROM source()
            WHERE DetectionName =~ '^(RMM|Remote Access)'
                AND RMMDisposition = 'Review'
                AND LocationContext =~ 'User or temporary|Other|Unresolved'

      - type: vql_suggestion
        name: Whitelist suppression audit
        template: |
            /*
            ### Whitelist suppression audit
            Collect with SuppressWhitelisted disabled to populate this view.
            */

            SELECT WhitelistCandidate.WhitelistID as WhitelistID,
                RuleID,
                DetectionName,
                WhitelistCandidate.Reason as Reason,
                WhitelistCandidate.Source as Source,
                WhitelistCandidate.ReviewDate as ReviewDate,
                count() as Total,
                enumerate(items=Fqdn) as Endpoints,
                OSPath as ExampleOSPath
            FROM source()
            WHERE Disposition = 'Suppressed'
            GROUP BY WhitelistID,RuleID
            ORDER BY Total DESC

      - type: vql_suggestion
        name: MFT and Amcache exact path correlation
        template: |
            /*
            ### MFT and Amcache exact path correlation
            Requires MFT and Amcache results in the same hunt or collection.
            */

            LET DRMFT = SELECT *,
                    Fqdn as MFTFqdn,
                    OSPath as MFTPath,
                    RuleID as MFTRuleID,
                    DetectionName as MFTDetection
                FROM source(
                    artifact='DetectRaptor.Windows.Detection.MFT')

            SELECT MFTFqdn as Fqdn,
                MFTPath as OSPath,
                MFTRuleID,
                MFTDetection,
                RuleID as AmcacheRuleID,
                DetectionName as AmcacheDetection,
                KeyMTime,
                SHA1
            FROM foreach(row=DRMFT,query={
                SELECT *
                FROM source(
                    artifact='DetectRaptor.Windows.Detection.Amcache')
                WHERE Fqdn = MFTFqdn
                    AND EntryPath = MFTPath
            })

      - type: vql_suggestion
        name: Cross-artifact correlation pivots
        template: |
            /*
            ### Cross-artifact correlation pivots
            Normalize available MFT, Amcache, BinaryRename, EVTX, and
            PSReadLine results into a common endpoint, path, and time view.
            */

            SELECT * FROM chain(
                mft={
                    SELECT Fqdn,'MFT' as Artifact,OSPath,FileName,
                        RuleID,DetectionName,
                        SITimestamps.LastModified0x10 as EventTime,
                        '' as Context
                    FROM source(
                        artifact='DetectRaptor.Windows.Detection.MFT')
                },
                amcache={
                    SELECT Fqdn,'Amcache' as Artifact,
                        EntryPath as OSPath,EntryName as FileName,
                        RuleID,DetectionName,KeyMTime as EventTime,
                        OriginalFileName as Context
                    FROM source(
                        artifact='DetectRaptor.Windows.Detection.Amcache')
                },
                binary_rename={
                    SELECT Fqdn,'BinaryRename' as Artifact,OSPath,
                        Name as FileName,'' as RuleID,
                        'Binary rename' as DetectionName,
                        Ctime as EventTime,
                        VersionInformation as Context
                    FROM source(
                        artifact='DetectRaptor.Windows.Detection.BinaryRename')
                },
                evtx={
                    SELECT Computer as Fqdn,'EVTX' as Artifact,OSPath,
                        '' as FileName,'' as RuleID,
                        Detection.Name as DetectionName,
                        EventTime,Message as Context
                    FROM source(
                        artifact='DetectRaptor.Windows.Detection.Evtx')
                },
                psreadline={
                    SELECT Fqdn,'PSReadLine' as Artifact,
                        FileInfo.OSPath as OSPath,'' as FileName,
                        RuleID,RuleName as DetectionName,
                        FileInfo.Mtime as EventTime,Line as Context
                    FROM source(
                        artifact='DetectRaptor.Windows.Detection.Powershell.PSReadline')
                })
            ORDER BY Fqdn,EventTime

      - type: vql_suggestion
        name: SI and FN timestamp differences
        template: |
            /*
            ### SI and FN timestamp differences
            Review suspicious-location files where SI and FN timestamps differ.
            */

            SELECT *
            FROM source()
            WHERE Detection.Name =~ '^Suspicious Location'
                AND (SITimestamps.Created0x10 != FNTimestamps.Created0x30
                    OR SITimestamps.LastModified0x10 != FNTimestamps.LastModified0x30)
