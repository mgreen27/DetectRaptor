name: DetectRaptor.Windows.Detection.MFT
author: Matt Green - @mgreen27
description: |
   Bulk indicator hunt over Windows.NTFS.MFT.

   This artifact is automatically generated by DetectRaptor.

reference:
  - https://github.com/mgreen27/DetectRaptor

type: CLIENT
resources:
  timeout: 9000

parameters:
   - name: DateAfter
     type: timestamp
     description: "search for events after this date. YYYY-MM-DDTmm:hh:ssZ"
   - name: DateBefore
     type: timestamp
     description: "search for events before this date. YYYY-MM-DDTmm:hh:ssZ"
   - name: AllDrives
     type: bool
     description: "Select MFT search on all attached ntfs drives."
   - name: CriticalityLevel
     default: .
     description: "Only use detections matching this regex (values can be Critical,High,Medium,Low)"
   - name: ApprovedRMMNameRegex
     default: ^$
     description: "Optional regex matching approved RMM detection names. Must be combined with ApprovedRMMPathRegex."
   - name: ApprovedRMMPathRegex
     default: ^$
     description: "Optional regex matching approved RMM installation paths. Must be combined with ApprovedRMMNameRegex."
   - name: IOCs
     type: csv
     default: |
%splitme% 

sources:
  - precondition:
      SELECT OS From info() where OS = 'windows'

    query: |
      -- firstly split IOCs by path or filename focus
      LET all_the_things <= SELECT * FROM IOCs
        WHERE NOT KeywordRegex = '.'
            AND Criticality =~ CriticalityLevel
            AND Scope =~ '^(MFT|Both)$'

      LET keyword_patterns <= SELECT KeywordRegex
        FROM all_the_things
        GROUP BY KeywordRegex

      LET hits = SELECT EntryNumber,InUse,OSPath,FileName,FileSize,IsDir,
            Created0x10,LastModified0x10,LastRecordChange0x10,LastAccess0x10,
            Created0x30,LastModified0x30,LastRecordChange0x30,LastAccess0x30
        FROM Artifact.Windows.NTFS.MFT(
                                FileRegex=join(array=keyword_patterns.KeywordRegex,sep='|'),
                                DateBefore=DateBefore,
                                DateAfter=DateAfter,
                                AllDrives=AllDrives )

      -- output results and enrich with IOC data
      SELECT * FROM foreach(row=hits,query={
            SELECT
                dict(
                    RuleID=RuleID,
                    Name=Detection,
                    Category=Category,
                    Technique=Technique,
                    Confidence=Confidence,
                    KeywordRegex=KeywordRegex,
                    PathRegex=PathRegex,
                    IgnoreRegex=IgnoreRegex,
                    Reference=Reference,
                    Scope=Scope,
                    EntryType=EntryType,
                    Source=Source,
                    SourceID=SourceID,
                    StringHit=parse_string_with_regex(string=FileName,regex='(' + KeywordRegex + ')' ).g1,
                    Criticality=Criticality
                        ) as Detection,
                if(condition=OSPath =~ '''\\<Err\>|\\<UnknownEntry\>|\\<Parent ''',
                    then='Unresolved',
                    else=if(condition=OSPath =~ '''\\Users\\|\\Windows\\(Temp|SystemTemp)\\|\\\$Recycle\.Bin\\''',
                        then='User or temporary',
                        else=if(condition=OSPath =~ '''\\Program Files( \(x86\))?\\|\\ProgramData\\chocolatey\\''',
                            then='Installed',
                            else=if(condition=OSPath =~ '''\\ProgramData\\''',
                                then='ProgramData',
                                else=if(condition=OSPath =~ '''\\Windows\\''',
                                    then='System',
                                    else='Other'))))) as LocationContext,
                if(condition=Category = 'Remote Access Software',
                    then=if(condition=Detection =~ ApprovedRMMNameRegex
                            AND OSPath =~ ApprovedRMMPathRegex,
                        then='Approved',
                        else='Review'),
                    else='Not applicable') as RMMDisposition,
                EntryNumber,InUse,OSPath,FileSize,IsDir,
                dict(Created0x10=Created0x10,LastModified0x10=LastModified0x10,LastRecordChange0x10=LastRecordChange0x10,LastAccess0x10=LastAccess0x10) as SITimestamps,
                dict(Created0x30=Created0x30,LastModified0x30=LastModified0x30,LastRecordChange0x30=LastRecordChange0x30,LastAccess0x30=LastAccess0x30) as FNTimestamps
            FROM all_the_things
            WHERE FileName =~ KeywordRegex
                AND OSPath =~ PathRegex
                AND (EntryType = 'Any'
                    OR (EntryType = 'File' AND NOT IsDir)
                    OR (EntryType = 'Directory' AND IsDir))
                AND NOT if(condition=IgnoreRegex,
                        then= OSPath =~ IgnoreRegex,
                        else= False )
        },workers=20)

    notebook:
      - type: vql_suggestion
        name: Detection summary
        template: |
            /*
            ### Detection summary
            */

            SELECT Detection.RuleID,
               Detection.Name,
               Detection.Category as Category,
               Detection.Criticality as Criticality,
               count() AS Total
            FROM source()
            GROUP BY Detection.RuleID
            ORDER BY Total DESC
      - type: vql_suggestion
        name: File match summary
        template: |
            /*
            ### File match summary
            Group every matching rule for the same OSPath on each endpoint.
            */

            SELECT Fqdn,
                OSPath,
                count() as MatchCount,
                enumerate(items=Detection.RuleID) as RuleIDs,
                enumerate(items=Detection.Name) as Detections,
                enumerate(items=Detection.Category) as Categories,
                enumerate(items=Detection.Technique) as Techniques,
                enumerate(items=Detection.Confidence) as Confidences,
                enumerate(items=Detection.Criticality) as Criticalities,
                EntryNumber,
                InUse,
                IsDir,
                FileSize,
                SITimestamps,
                FNTimestamps
            FROM source()
            GROUP BY Fqdn,OSPath
            ORDER BY MatchCount DESC
      - type: vql_suggestion
        name: Timeline preparation
        template: |
            /*
            ### Create timestamps for timeline - typically Modified is best timestamp.
            */

            SELECT *, 
               Detection.Name + "|" + Detection.StringHit + "|" + OSPath as Message,
               SITimestamps.LastModified0x10 as SIModified,
               SITimestamps.Created0x10 as SICreated
            FROM source()


      - type: vql_suggestion
        name: Criticality filter
        template: |
            /*
            ### Detection filter
            Use this notebook to modify filter and target specific Criticality Detections.
            */

            SELECT Fqdn,
                Detection.Name as Detection,
                Detection.Criticality as Criticality,
                OSPath,
                Detection.StringHit as StringHit,
                Detection.KeywordRegex as KeywordRegex,
                InUse,IsDir,FileSize,
                SITimestamps.Created0x10 as Created0x10,
                SITimestamps.LastModified0x10 as LastModified0x10,
                FNTimestamps.Created0x30 as Created0x30,
                FNTimestamps.LastModified0x30 as LastModified0x30
            FROM source()
            WHERE Detection.Criticality =~ 'Critical|High'


      - type: vql_suggestion
        name: Detection filter
        template: |
            /*
            ### Detection filter
            Use this notebook to modify filter and target specific Detections.
            */

            SELECT Fqdn,
                Detection.Name as Detection,
                Detection.Criticality as Criticality,
                OSPath,
                Detection.StringHit as StringHit,
                Detection.KeywordRegex as KeywordRegex,
                InUse,IsDir,FileSize,
                SITimestamps.Created0x10 as Created0x10,
                SITimestamps.LastModified0x10 as LastModified0x10,
                FNTimestamps.Created0x30 as Created0x30,
                FNTimestamps.LastModified0x30 as LastModified0x30
            FROM source()
            WHERE Detection.Name =~ 'Defence Evasion|RMM'

      - type: vql_suggestion
        name: Detection folder grouping
        template: |
            /*
            ### Detection folder grouping
            Use this notebook to modify group by folder and figure out ignore list filters
            */

            SELECT Fqdn,
                Detection.Name as Detection,
                Detection.StringHit as StringHit,
                Detection.KeywordRegex as KeywordRegex,
                if(condition= IsDir,
                    then= OSPath, else=dirname(path=OSPath)) as Directory,
                count() as Total,
                OSPath as ExampleOSPath
            FROM source()
            WHERE Detection.Name =~ 'Defence Evasion|RMM'
                --AND NOT OSPath =~ '''ADD HERE'''
            GROUP BY Fqdn,Detection,Directory

      - type: vql_suggestion
        name: RMM location summary
        template: |
            /*
            ### RMM location summary
            Separate installed, portable, unresolved, and other RMM locations.
            */

            SELECT Detection.Name as Detection,
                RMMDisposition,
                LocationContext,
                count() as Total,
                OSPath as ExampleOSPath
            FROM source()
            WHERE Detection.Name =~ '^(RMM|Remote Access)'
            GROUP BY Detection,RMMDisposition,LocationContext
            ORDER BY Total DESC

      - type: vql_suggestion
        name: RMM portable or unusual paths
        template: |
            /*
            ### RMM portable or unusual paths
            Review unapproved RMM in user, temporary, unresolved, or other paths.
            */

            SELECT *
            FROM source()
            WHERE Detection.Name =~ '^(RMM|Remote Access)'
                AND RMMDisposition = 'Review'
                AND LocationContext =~ 'User or temporary|Other|Unresolved'

      - type: vql_suggestion
        name: SI and FN timestamp differences
        template: |
            /*
            ### SI and FN timestamp differences
            Review suspicious-location files where SI and FN timestamps differ.
            */

            SELECT *
            FROM source()
            WHERE Detection.Name =~ '^Suspicious Location'
                AND (SITimestamps.Created0x10 != FNTimestamps.Created0x30
                    OR SITimestamps.LastModified0x10 != FNTimestamps.LastModified0x30)
