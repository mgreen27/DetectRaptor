name: DetectRaptor.Windows.Detection.Amcache
author: Zach Stanford - @svch0st
description: |
   Bulk indicator hunt over Amcache

   This artifact is automatically generated by DetectRaptor.

reference:
  - https://github.com/mgreen27/DetectRaptor

type: CLIENT
resources:
  timeout: 9000

parameters:
   - name: DateAfter
     type: timestamp
     description: "search for events after this date. YYYY-MM-DDTmm:hh:ssZ"
   - name: DateBefore
     type: timestamp
     description: "search for events before this date. YYYY-MM-DDTmm:hh:ssZ"
   - name: CriticalityLevel
     default: .
     description: "Only use detections matching this regex (values can be Critical,High,Medium,Low)"
   - name: ApprovedRMMNameRegex
     default: ^$
     description: "Optional regex matching approved RMM detection names. Must be combined with ApprovedRMMPathRegex."
   - name: ApprovedRMMPathRegex
     default: ^$
     description: "Optional regex matching approved RMM installation paths. Must be combined with ApprovedRMMNameRegex."
   - name: IOCs
     type: csv
     default: |
%splitme%

sources:
  - precondition:
      SELECT OS From info() where OS = 'windows'

    query: |
      -- firstly split IOCs by path or filename focus
      LET all_the_things <= SELECT * FROM IOCs
        WHERE NOT KeywordRegex = '.'
            AND Criticality =~ CriticalityLevel
            AND Scope =~ '^(Amcache|Both)$'
            AND NOT EntryType = 'Directory'
        GROUP BY KeywordRegex
      
      -- run KeywordRegex regex
      LET hits = SELECT * FROM Artifact.Windows.Detection.Amcache(
                                KeyPathGlob='/Root/{Inventory, File}*/**',
                                NameRegex=join(array=all_the_things.KeywordRegex,sep='|'))
      
      -- output results and enrich with IOC data
      SELECT * FROM foreach(row=hits,query={
            SELECT 
                dict(
                    Name=Detection,
                    KeywordRegex=KeywordRegex,
                    PathName=EntryPath,
                    Reference=Reference,
                    Scope=Scope,
                    EntryType=EntryType,
                    Criticality=Criticality) as Detection,
                if(condition=EntryPath =~ '''\\<Err\>|\\<UnknownEntry\>|\\<Parent ''',
                    then='Unresolved',
                    else=if(condition=EntryPath =~ '''\\Users\\|\\Windows\\(Temp|SystemTemp)\\|\\\$Recycle\.Bin\\''',
                        then='User or temporary',
                        else=if(condition=EntryPath =~ '''\\Program Files( \(x86\))?\\|\\ProgramData\\chocolatey\\''',
                            then='Installed',
                            else=if(condition=EntryPath =~ '''\\ProgramData\\''',
                                then='ProgramData',
                                else=if(condition=EntryPath =~ '''\\Windows\\''',
                                    then='System',
                                    else='Other'))))) as LocationContext,
                if(condition=Detection =~ '^(RMM|Remote Access)',
                    then=if(condition=Detection =~ ApprovedRMMNameRegex
                            AND EntryPath =~ ApprovedRMMPathRegex,
                        then='Approved',
                        else='Review'),
                    else='Not applicable') as RMMDisposition,
                KeyMTime,EntryName,EntryPath,Publisher,OriginalFileName,SHA1
            FROM all_the_things
            WHERE ( EntryName =~ KeywordRegex OR OriginalFileName =~ KeywordRegex )
                AND EntryPath =~ PathRegex
                AND NOT if(condition=IgnoreRegex,
                    then= EntryPath =~ IgnoreRegex,
                    else= False )
            LIMIT 1
        },workers=20)

    notebook:
      - type: vql_suggestion
        name: Detection Filter
        template:  |
            /*
            ### Detection Filter
            Use this notebook to modify filter and target specific Detections.
            */

            SELECT *
            FROM source()
            WHERE Detection.Name =~ "VPN|Execution"
      - type: vql_suggestion
        name: Critical and High Detections Only
        template: |
            /*
            ### Critical and High Detections
            Use this notebook to modify filter and target specific Criticality Detections.
            */

            SELECT *
            FROM source()
            WHERE Detection.Criticality =~ "critical|high"

      - type: vql_suggestion
        name: Detection Summary
        template: |
            /*
            ### Detection Summary
            */
            
            SELECT Detection.Name, count() AS Total
            FROM source()
            GROUP BY Detection.Name
            ORDER BY Total DESC 

      - type: vql_suggestion
        name: RMM location summary
        template: |
            /*
            ### RMM location summary
            Separate installed, portable, unresolved, and other RMM locations.
            */

            SELECT Detection.Name as Detection,
                RMMDisposition,
                LocationContext,
                count() as Total,
                EntryPath as ExampleEntryPath
            FROM source()
            WHERE Detection.Name =~ '^(RMM|Remote Access)'
            GROUP BY Detection,RMMDisposition,LocationContext
            ORDER BY Total DESC
