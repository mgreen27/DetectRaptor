name: DetectRaptor.Windows.Detection.Amcache
author: Zach Stanford - @svch0st
description: |
   Bulk indicator hunt over Amcache

   This artifact is automatically generated by DetectRaptor.

reference:
  - https://github.com/mgreen27/DetectRaptor

type: CLIENT
resources:
  timeout: 9000

parameters:
   - name: DateAfter
     type: timestamp
     description: "search for events after this date. YYYY-MM-DDTmm:hh:ssZ"
   - name: DateBefore
     type: timestamp
     description: "search for events before this date. YYYY-MM-DDTmm:hh:ssZ"
   - name: CriticalityLevel
     default: .
     description: "Only use detections matching this regex (values can be Critical,High,Medium,Low)"
   - name: ApprovedRMMNameRegex
     default: ^$
     description: "Optional regex matching approved RMM detection names. Must be combined with ApprovedRMMPathRegex."
   - name: ApprovedRMMPathRegex
     default: ^$
     description: "Optional regex matching approved RMM installation paths. Must be combined with ApprovedRMMNameRegex."
   - name: SuppressWhitelisted
     type: bool
     default: true
     description: "Suppress built-in RuleID, filename, and path whitelist matches. Disable to audit suppressed rows."
   - name: Whitelists
     type: csv
     default: |
%whitelist%
   - name: IOCs
     type: csv
     default: |
%splitme%

sources:
  - precondition:
      SELECT OS From info() where OS = 'windows'

    query: |
      -- firstly split IOCs by path or filename focus
      LET all_the_things <= SELECT * FROM IOCs
        WHERE NOT KeywordRegex = '.'
            AND Criticality =~ CriticalityLevel
            AND Scope =~ '^(Amcache|Both)$'
            AND NOT EntryType = 'Directory'

      LET whitelist_lookup <= memoize(
        key='LookupKey',
        query={
          SELECT *, RuleID + '|Amcache' AS LookupKey
          FROM Whitelists
          WHERE Artifact = 'Amcache'
              AND Disposition = 'Suppress'
        }, period=100000)

      LET keyword_patterns <= SELECT KeywordRegex
        FROM all_the_things
        GROUP BY KeywordRegex
      
      -- run KeywordRegex regex
      LET hits = SELECT * FROM Artifact.Windows.Detection.Amcache(
                                KeyPathGlob='/Root/{Inventory, File}*/**',
                                NameRegex=join(array=keyword_patterns.KeywordRegex,sep='|'))
      
      -- output results and enrich with IOC data
      LET rule_hits = SELECT * FROM foreach(row=hits,query={
            SELECT 
                RuleID,
                Detection as DetectionName,
                Category,
                Technique,
                Confidence,
                Criticality,
                Source,
                SourceID,
                EntryName as FileName,
                EntryPath as OSPath,
                dict(
                    RuleID=RuleID,
                    Name=Detection,
                    Category=Category,
                    Technique=Technique,
                    Confidence=Confidence,
                    KeywordRegex=KeywordRegex,
                    PathName=EntryPath,
                    Reference=Reference,
                    Scope=Scope,
                    EntryType=EntryType,
                    Source=Source,
                    SourceID=SourceID,
                    Criticality=Criticality) as Detection,
                if(condition=EntryPath =~ '''\\<Err\>|\\<UnknownEntry\>|\\<Parent ''',
                    then='Unresolved',
                    else=if(condition=EntryPath =~ '''\\Users\\|\\Windows\\(Temp|SystemTemp)\\|\\\$Recycle\.Bin\\''',
                        then='User or temporary',
                        else=if(condition=EntryPath =~ '''\\Program Files( \(x86\))?\\|\\ProgramData\\chocolatey\\''',
                            then='Installed',
                            else=if(condition=EntryPath =~ '''\\ProgramData\\''',
                                then='ProgramData',
                                else=if(condition=EntryPath =~ '''\\Windows\\''',
                                    then='System',
                                    else='Other'))))) as LocationContext,
                if(condition=Category = 'Remote Access Software',
                    then=if(condition=Detection =~ ApprovedRMMNameRegex
                            AND EntryPath =~ ApprovedRMMPathRegex,
                        then='Approved',
                        else='Review'),
                    else='Not applicable') as RMMDisposition,
                KeyMTime,EntryName,EntryPath,Publisher,OriginalFileName,SHA1
            FROM all_the_things
            WHERE ( EntryName =~ KeywordRegex OR OriginalFileName =~ KeywordRegex )
                AND EntryPath =~ PathRegex
                AND NOT if(condition=IgnoreRegex,
                    then= EntryPath =~ IgnoreRegex,
                    else= False )
        },workers=20)

      LET candidate_hits = SELECT *,
          get(
            item=whitelist_lookup,
            field=RuleID + '|Amcache') AS WhitelistCandidate
        FROM rule_hits

      LET classified_hits = SELECT *,
          if(
            condition=WhitelistCandidate
              AND (EntryName =~ WhitelistCandidate.FilenameRegex
                OR OriginalFileName =~ WhitelistCandidate.FilenameRegex)
              AND EntryPath =~ WhitelistCandidate.PathRegex,
            then='Suppressed',
            else='Retained') AS Disposition
        FROM candidate_hits

      SELECT * FROM classified_hits
      WHERE NOT SuppressWhitelisted
          OR Disposition != 'Suppressed'

    notebook:
      - type: vql_suggestion
        name: Detection Filter
        template:  |
            /*
            ### Detection Filter
            Use this notebook to modify filter and target specific Detections.
            */

            SELECT *
            FROM source()
            WHERE Detection.Name =~ "VPN|Execution"
      - type: vql_suggestion
        name: Critical and High Detections Only
        template: |
            /*
            ### Critical and High Detections
            Use this notebook to modify filter and target specific Criticality Detections.
            */

            SELECT *
            FROM source()
            WHERE Detection.Criticality =~ "critical|high"

      - type: vql_suggestion
        name: Detection Summary
        template: |
            /*
            ### Detection Summary
            */
            
            SELECT RuleID,DetectionName,Category,Confidence,Criticality,
                count() AS Total
            FROM source()
            GROUP BY RuleID
            ORDER BY Total DESC 

      - type: vql_suggestion
        name: Operational metrics
        template: |
            /*
            ### Operational metrics
            Separate total rule matches from unique endpoint paths and
            multi-match expansion.
            */

            LET DRRows = SELECT * FROM source()
            LET DRPaths = SELECT Fqdn,EntryPath,count() AS MatchCount
                FROM DRRows
                GROUP BY Fqdn,EntryPath
            LET DRMultiPaths = SELECT * FROM DRPaths
                WHERE MatchCount > 1
            LET DREndpoints = SELECT Fqdn FROM DRRows
                GROUP BY Fqdn

            SELECT * FROM chain(
                rule_matches={
                    SELECT 'Rule matches' AS Metric,count() AS Value
                    FROM DRRows
                },
                unique_paths={
                    SELECT 'Unique endpoint paths' AS Metric,count() AS Value
                    FROM DRPaths
                },
                multi_match_paths={
                    SELECT 'Multi-match endpoint paths' AS Metric,
                        count() AS Value
                    FROM DRMultiPaths
                },
                endpoints={
                    SELECT 'Endpoints' AS Metric,count() AS Value
                    FROM DREndpoints
                })

      - type: vql_suggestion
        name: File match summary
        template: |
            /*
            ### File match summary
            Group every Amcache rule matching the same path.
            */

            SELECT Fqdn,EntryPath,
                count() as MatchCount,
                enumerate(items=RuleID) as RuleIDs,
                enumerate(items=DetectionName) as Detections,
                enumerate(items=Category) as Categories,
                enumerate(items=Technique) as Techniques,
                enumerate(items=Confidence) as Confidences,
                KeyMTime,Publisher,OriginalFileName,SHA1
            FROM source()
            GROUP BY Fqdn,EntryPath
            ORDER BY MatchCount DESC

      - type: vql_suggestion
        name: RMM location summary
        template: |
            /*
            ### RMM location summary
            Separate installed, portable, unresolved, and other RMM locations.
            */

            SELECT RuleID,
                DetectionName as Detection,
                SourceID,
                RMMDisposition,
                LocationContext,
                count() as Total,
                enumerate(items=Fqdn) as Endpoints,
                EntryPath as ExampleEntryPath
            FROM source()
            WHERE DetectionName =~ '^(RMM|Remote Access)'
            GROUP BY RuleID,RMMDisposition,LocationContext
            ORDER BY Total DESC

      - type: vql_suggestion
        name: Whitelist suppression audit
        template: |
            /*
            ### Whitelist suppression audit
            Collect with SuppressWhitelisted disabled to populate this view.
            */

            SELECT WhitelistCandidate.WhitelistID as WhitelistID,
                RuleID,
                DetectionName,
                WhitelistCandidate.Reason as Reason,
                WhitelistCandidate.Source as Source,
                WhitelistCandidate.ReviewDate as ReviewDate,
                count() as Total,
                enumerate(items=Fqdn) as Endpoints,
                EntryPath as ExampleEntryPath
            FROM source()
            WHERE Disposition = 'Suppressed'
            GROUP BY WhitelistID,RuleID
            ORDER BY Total DESC
